/*
 * Minimal CI profile: the synthetic fixture shipped with hicpup, no network.
 *
 *     nextflow run . -profile test,docker --outdir results
 *
 * The parameter values below are not cosmetic - they were measured against this
 * fixture, and the pipeline defaults do NOT work on it:
 *
 *   flank=100000 (the default) exceeds the fixture's 200 kb chrX, so coolpuppy
 *   piles up 0 windows and emits an all-NaN 201x201 matrix. It does not fail -
 *   the run goes green and the figure comes out empty. flank=20000 gives 4
 *   windows and a 41x41 matrix with ~7% NaN.
 *
 *   ndiags=40 (the default) crashes on that 41x41 matrix with an IndexError out
 *   of cone.cone_diagonals; 17 is the largest value that works. 15 leaves margin.
 *
 * Only fountains_X.bed exists in the fixture, so `fountains_a` stays unset and
 * the pipeline analyses view X only (main.nf derives the view list from which
 * fountain BEDs are provided).
 */

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Synthetic hicpup fixture, offline, for CI'

    input       = "${projectDir}/assets/samplesheet_test.csv"
    chromsizes  = "${projectDir}/assets/test_data/ce10.chrom.sizes"
    fountains_x = "${projectDir}/assets/test_data/fountains_X.bed"
    fountains_a = null

    resolution  = 1000
    flank       = 20000
    ndiags      = 15
    cone_angle  = 60
}

// Cap everything to what a GitHub Actions runner has (4 CPU / 16 GB). These must
// be withLabel overrides, not a bare `process` block - label selectors take
// priority over the generic directive, so a bare block would not cap anything.
process {
    withLabel: process_low    { cpus = 1; memory = 2.GB; time = 30.min }
    withLabel: process_medium { cpus = 2; memory = 4.GB; time = 30.min }
    withLabel: process_high   { cpus = 2; memory = 6.GB; time = 30.min }
}
