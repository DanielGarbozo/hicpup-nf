/*
 * Per-process resource requests.
 *
 * Deliberately modest: the heavy step is cooltools.expected_cis / coolpup.pileup,
 * both of which take an explicit nproc that this pipeline wires to task.cpus, so
 * a label change here actually changes the tool's parallelism too.
 */

process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 138, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_low {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
