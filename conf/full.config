/*
 * Real public data: GSE188849 (Hi-C SubSeries, Ercan lab), C. elegans L2-L3,
 * auxin 1 hr. CA1200 (control) vs SS01A (treatment), deposited as Juicer .hic.
 *
 *     nextflow run . -profile full,docker --outdir results_full
 *
 * Not run in CI: the two .hic files are ~2.4 Gb combined. The samplesheet points
 * at the GEO FTP URLs directly - Nextflow stages http(s) inputs itself, so there
 * is no separate download process. HIC2COOL then converts each .hic to a
 * single-resolution .cool at `params.resolution`.
 *
 * Single-resolution .cool, not .mcool, on purpose: hicpup's io.load_coolers
 * does a plain Path.exists() on the configured path, so a multi-resolution URI
 * like `x.mcool::/resolutions/1000` is rejected before cooler ever sees it.
 *
 * `fountains_a` is unset here for the same reason as in the test profile - the
 * published fountain calls used by hicpup are chrX. Set it to a BED4 of autosomal
 * fountains to get the A panel as well.
 */

params {
    config_profile_name        = 'Full profile'
    config_profile_description = 'GSE188849 CA1200 vs SS01A, Juicer .hic -> cooler -> cone profiles'

    input       = "${projectDir}/assets/samplesheet_full.csv"
    chromsizes  = "${projectDir}/assets/ce10.chrom.sizes"
    fountains_x = "${projectDir}/assets/fountains_X.bed"
    fountains_a = null

    resolution  = 1000
    flank       = 100000
    ndiags      = 40
    cone_angle  = 60
}
