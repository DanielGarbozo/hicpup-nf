/*
 * hicpup-nf - downstream Hi-C fountain analysis (hicpup Module A).
 *
 * Pipeline-level parameters and execution profiles. Per-process resources live
 * in conf/base.config; per-profile input data in conf/{test,full}.config.
 */

params {
    // Input
    input        = null                 // samplesheet: strain,replicate,matrix
    outdir       = 'results'

    // Shared reference assets
    chromsizes   = null                 // 5 autosomes + chrX (hicpup.views requires exactly 6)
    fountains_x  = null                 // BED4: chrom, start, end, strength
    fountains_a  = null                 // optional; when unset, view A is not analysed

    // Analysis
    resolution   = 1000                 // bp/bin; validated against clr.binsize by hicpup
    flank        = 100000               // pileup flank in bp -> (2*flank/resolution + 1) matrix
    cone_angle   = 60
    ndiags       = 40                   // must fit the pileup matrix; see conf/test.config
    min_diag     = 0

    // Containers
    hicpup_container   = 'ghcr.io/danielgarbozo/hicpup-nf:0.1.0'
    hic2cool_container = 'ghcr.io/danielgarbozo/hicpup-nf-hic2cool:0.1.0'

    // Boilerplate
    help                       = false
    publish_dir_mode           = 'copy'
    validate_params            = true
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test { includeConfig 'conf/test.config' }
    full { includeConfig 'conf/full.config' }
}

// Provenance: written for every run, regardless of profile.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag.html";       overwrite = true }

manifest {
    name            = 'DanielGarbozo/hicpup-nf'
    author          = 'Daniel Garbozo'
    homePage        = 'https://github.com/DanielGarbozo/hicpup-nf'
    description     = 'Downstream Hi-C fountain cone profiles: wraps the hicpup CLI (Module A).'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.1.0'
    license         = 'MIT'
}
